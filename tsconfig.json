{
  // JS -> TS migration is complete (see AGENTS.md "TypeScript Migration"):
  // every file under `src/` is `.ts`/`.tsx`, so `allowJs`/`checkJs` are
  // omitted (both default to false) and `tsc --noEmit` type-checks the
  // whole tree under `strict: true`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "*.config.ts", "e2e"],
  "exclude": ["node_modules", "dist"]
}
